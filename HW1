%% Steady-state analysis of xdot = A*x + B*u, y = C*x
clear; clc; close all;

% System matrices
A = [-0.1    0.002;
      0      0.1];
B = [1; 10];
C = [1 -0.01];
D = 0;

% Constant input
u = 1;   % change this to whatever input value you want

%% 1. Check eigenvalues (stability)
eigA = eig(A);
disp('Eigenvalues of A:')
disp(eigA)

if all(real(eigA) < 0)
    disp('System is stable -> steady state is meaningful/attracting.')
else
    disp('System is UNSTABLE (an eigenvalue has non-negative real part).')
    disp('An equilibrium point still exists, but trajectories will not converge to it.')
end

%% 2. Solve for equilibrium point: 0 = A*xbar + B*u
xbar = -A\(B*u);
ybar = C*xbar;

fprintf('\nEquilibrium state xbar:\n');
disp(xbar)
fprintf('Corresponding output ybar = %.4f\n', ybar);

%% 3. Simulate the actual response to see if it approaches xbar
sys = ss(A, B, C, D);

t = 0:0.01:50;
uvec = u*ones(size(t));
x0 = [0; 0];   % initial condition (try changing this)

[y, t, x] = lsim(sys, uvec, t, x0);

%% 4. Plot states vs time, with equilibrium line for reference
figure;
subplot(2,1,1)
plot(t, x(:,1), 'b', 'LineWidth', 1.5); hold on
plot(t, x(:,2), 'r', 'LineWidth', 1.5);
yline(xbar(1), 'b--', 'x_1 equilibrium');
yline(xbar(2), 'r--', 'x_2 equilibrium');
xlabel('Time'); ylabel('State value');
title('State trajectories vs equilibrium (steady-state) point');
legend('x_1(t)', 'x_2(t)', 'Location', 'best');
grid on

subplot(2,1,2)
plot(t, y, 'k', 'LineWidth', 1.5); hold on
yline(ybar, 'g--', 'y equilibrium');
xlabel('Time'); ylabel('Output y');
title('Output response');
grid on

%% 5. Phase portrait (state-space trajectory)
figure;
plot(x(:,1), x(:,2), 'b', 'LineWidth', 1.5); hold on
plot(xbar(1), xbar(2), 'ko', 'MarkerSize', 8, 'MarkerFaceColor', 'k');
text(xbar(1), xbar(2), '  equilibrium', 'FontSize', 10)
xlabel('x_1'); ylabel('x_2');
title('Phase portrait');
grid on
